# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# true until registration opens: preview strip, no search indexing, and only PREVIEW_EMAILS
# (default: ADMIN_EMAILS) can sign up or sign in.
PRE_LAUNCH=true
ADMIN_EMAILS=
PREVIEW_EMAILS=

# Database (shared Aquamark Supabase project; service role, server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email. Without a token outside production, emails are printed to the console instead.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Broker Registry <no-reply@broker-registry.org>
EMAIL_REPLY_TO=support@broker-registry.org

# Long random values. Never change the two FIELD_ keys once data exists: stored dates of birth
# can't be read without them.
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=

# Optional: Cloudflare Turnstile bot check on sign-up
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Later steps:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
