</main>
<% const year = Math.max(new Date().getFullYear(), 2027);
   const slim = signedIn || (typeof adminArea !== 'undefined' && adminArea); /* signed-in pages get a one-line footer */ %>
<% if (slim) { %>
<footer class="footer footer-slim">
  <div class="footer-inner">
    <p>&copy; <%= year %> CSBFP</p>
    <nav aria-label="Legal"><a href="/legal/terms">Program Terms</a><a href="/legal/privacy">Privacy Policy</a></nav>
  </div>
</footer>
<% } else { %>
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-about">
        <img class="footer-logo" src="/img/csbfp-logo.png?v=<%= assetV %>" alt="Certified SBFP" width="92" height="48">
        <p class="disclaimer">The Certified Small Business Finance Professional (CSBFP) credential is a private industry certification. It is not a government license or regulatory approval, and it does not authorize anyone to perform activities that require a license.</p>
      </div>
      <nav class="footer-cols" aria-label="Footer">
        <div>
          <p class="footer-head">Program</p>
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href="/employers">For Employers</a>
          <a href="/verify">Verify a Certification</a>
        </div>
        <div>
          <p class="footer-head">Help &amp; Legal</p>
          <a href="/support">Contact</a>
          <a href="/legal/terms">Program Terms</a>
          <a href="/legal/privacy">Privacy Policy</a>
        </div>
      </nav>
    </div>
    <div class="footer-row">
      <p class="footer-label">Industry Partners</p>
      <div class="footer-logos">
        <a href="https://sbfassociation.org/" target="_blank" rel="noopener noreferrer"><img src="/img/sbfa.png" alt="Small Business Finance Association" height="30"></a>
        <a href="https://mainstreetcapital.org/" target="_blank" rel="noopener noreferrer"><img src="/img/main-street-capital.png" alt="Main Street Capital Partnership" height="30"></a>
        <span class="footer-badges">
          <a href="https://securebroker.org" target="_blank" rel="noopener noreferrer"><img class="badge" src="/img/secure-broker-badge.png?v=<%= assetV %>" alt="Secure Broker" width="52" height="52"></a>
          <a href="https://securefunder.org" target="_blank" rel="noopener noreferrer"><img class="badge" src="/img/secure-funder-badge.png?v=<%= assetV %>" alt="Secure Funder" width="52" height="52"></a>
        </span>
      </div>
    </div>
    <p class="operator">&copy; <%= year %> CSBFP · Independently administered for fair, consistent certification. <a href="/legal/terms#1-program-ownership-and-administration">See Program Terms</a>.</p>
  </div>
</footer>
<% } %>
</body>
</html>
