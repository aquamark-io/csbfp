<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<div class="narrow">
<h1>Confirm Your New Email</h1>
<p class="lead">We sent a 6-digit code to <strong><%= newEmail %></strong>. It expires in 10 minutes.</p>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="/portal/account/email/verify" novalidate>
  <div class="field"><label for="code">6-digit code</label><input id="code" class="code-input" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" autofocus></div>
  <button class="button" type="submit">Confirm</button>
</form>
<p class="muted"><a href="/portal/account">Cancel</a></p>
</div>
<%- include('../partials/foot') %>
