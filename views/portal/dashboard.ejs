<%- include('../partials/head') %>
<%
  const reg = progress.registration || {};
  const fmt = d => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '—';
  const certified = ['active', 'inactive', 'expired', 'suspended', 'revoked'].includes(reg.status);
  const inCheck = ['pending_screening', 'under_review', 'not_approved'].includes(reg.status);
  const paid = Boolean(reg.paid_at) || certified || inCheck;
  const passed = Boolean(train.assessment && train.assessment.passed);
  const appDone = progress.personal && progress.employment && progress.products && progress.acknowledgments;
  const modulesDone = train.modules.filter(m => m.completed).length;
  const checkOpen = reg.status === 'pending_screening';
  const linkOpened = Boolean(screening && screening.link_opened_at);

  // Every step, in order. `hint` explains a locked step; `desc` is shown when it's the next step.
  const steps = [
    { done: progress.personal, label: 'Personal information', href: '/portal/personal', desc: 'Your legal name, date of birth, home ZIP code and mobile number.' },
    { done: progress.employment, label: 'Employment', href: '/portal/employment', desc: 'Your current employer and role.' },
    { done: progress.products, label: 'Financing products', href: '/portal/products', desc: 'The commercial financing products you work with.' },
    { done: progress.acknowledgments, label: 'Professional standards', href: '/portal/acknowledgments', desc: 'Review and accept the CSBFP professional standards. About 2 minutes.' },
    { done: train.allComplete, label: 'Training modules', href: '/portal/training', desc: 'Four short modules. Your progress is saved as you go.',
      state: `${modulesDone} of ${train.modules.length} modules`, doneState: `${modulesDone} of ${train.modules.length} modules`, cta: modulesDone ? 'Continue' : 'Start' },
    { done: passed, label: 'Assessment', href: train.allComplete ? '/portal/assessment' : null, hint: 'After training', doneState: 'Passed',
      desc: '20 multiple-choice questions. You need 16 correct to pass.' },
    { done: paid, label: `Annual fee (${program.annualFee})`, href: passed && !paid ? '/portal/checkout' : null, hint: 'After assessment',
      desc: 'Pay by card, or enter your Employer ID if your employer is paying.', cta: 'Pay' },
    { done: screeningEnabled && screening && screening.status === 'approved', label: 'Background check',
      href: checkOpen && screeningEnabled ? '/portal/background-check' : null,
      hint: !screeningEnabled ? 'Not active yet' : checkOpen && linkOpened ? 'Results pending' : 'After payment',
      desc: 'A one-time background check through Checkr. About 10 minutes; results in 1–3 days.' },
    { done: certified, label: 'Certification issued', href: certified ? '/portal/confirmation' : null,
      hint: reg.status === 'under_review' ? 'Under review' : reg.status === 'not_approved' ? 'Not approved' : '' },
  ];
  const doneCount = steps.filter(s => s.done).length;
  const next = checkOpen && screeningEnabled && !linkOpened ? steps.find(s => s.label === 'Background check')
    : !certified && !inCheck ? steps.find(s => !s.done && s.href) : null;

%>
<h1 class="dash-title">Certification Dashboard</h1>
<% if (typeof saved !== 'undefined' && saved) { %><p class="notice-ok" role="status">Saved.</p><% } %>
<% if (reg.is_demo) { %><p class="demo-banner">DEMO / NOT SCREENED: background checks are not active yet, so this preview credential is not a valid CSBFP certification.</p><% } %>


<% const renewSoon = reg.status === 'active' && reg.expires_at && Date.parse(reg.expires_at) - Date.now() < 30 * 864e5;
   const confirmedRecently = registrant.info_confirmed_at && Date.now() - Date.parse(registrant.info_confirmed_at) < 300 * 864e5; %>
<% if (renewSoon && !confirmedRecently) { %>
<div class="message review-box">
  <p><strong>Annual review:</strong> your certification renews soon. Please check that your <a href="/portal/personal">contact details</a>, <a href="/portal/employment">employment</a> and <a href="/portal/products">products</a> are current.</p>
  <form method="post" action="/portal/confirm-info"><button class="button small" type="submit">My Information Is Current</button></form>
</div>
<% } %>
<% if (flagged) { %>
<p class="alert">We need to confirm a few details before your application can be completed. Please contact <a href="mailto:<%= program.supportEmail %>"><%= program.supportEmail %></a>.</p>
<% } %>

<%
  // What the "Next step" card says.
  const mail = `<a href="mailto:${program.supportEmail}">${program.supportEmail}</a>`;
  let card = null;
  if (reg.status === 'inactive') card = { band: 'Action needed', title: 'Renewal payment due', text: 'Your renewal payment didn\'t go through, so your certification is Inactive. Pay now to reactivate it.', href: '/portal/billing', cta: 'Pay Now' };
  else if (reg.status === 'expired') card = { band: 'Action needed', title: 'Your certification has expired', text: 'Renew it to make it active again with the same number.', href: '/portal/checkout', cta: 'Renew' };
  else if (reg.status === 'suspended') card = { band: 'Certification suspended', title: 'Suspended pending review', html: `To respond or ask about the process, contact ${mail}.` };
  else if (reg.status === 'revoked') card = { band: 'Certification revoked', title: 'Your certification has been revoked', html: `To ask about the appeal process, contact ${mail}.` };
  else if (reg.status === 'active') card = { band: 'Certified', title: 'You are a Certified Small Business Finance Professional', text: `Certification ${reg.registration_number}, valid through ${fmt(reg.expires_at)}.`, href: '/portal/confirmation', cta: 'View Certificate', second: { href: '/portal/billing', label: 'Billing' } };
  else if (checkOpen && linkOpened) card = { band: 'Status', title: 'Background check in progress', text: 'Your background check is in progress with Checkr. Results usually take 1–3 days, and we\'ll email you once they\'re reviewed.' };
  else if (reg.status === 'under_review') card = { band: 'Status', title: 'Under review', text: 'Your application is under review. We\'ll email you when a decision is made.' };
  else if (reg.status === 'not_approved') card = { band: 'Application status', title: 'Not approved', html: `Your application was not approved. To ask about reconsideration, contact ${mail}.` };
%>
<%
  const statusLabel = { active: 'Certified', inactive: 'Inactive', expired: 'Expired', suspended: 'Suspended', revoked: 'Revoked',
    pending_screening: 'Background check', under_review: 'Under review', not_approved: 'Not approved' }[reg.status] || 'In progress';
  const statusTone = reg.status === 'active' ? 'ok' : ['suspended', 'revoked', 'not_approved', 'inactive', 'expired'].includes(reg.status) ? 'warn' : 'info';
  const name = [registrant.legal_first_name, registrant.legal_last_name].filter(Boolean).join(' ');
  const appSteps = steps.filter(s => !['Training modules', 'Assessment', 'Certification issued'].includes(s.label));
  const stepState = s => s.done ? (s.doneState || 'Complete') : next && s === next ? 'Next step' : s.href ? (s.state && s.state !== 'Start' ? s.state : 'Not started') : (s.hint || 'Locked');
  const nextMod = train.modules.find(m => m.unlocked && !m.completed);
%>
<div class="dboard">
  <aside class="dpanel dprofile">
    <h2>Profile</h2>
    <dl class="dlist">
      <div><dt>Name</dt><dd><%= name || 'Not added yet' %></dd></div>
      <div><dt>Email</dt><dd class="break"><%= registrant.email %></dd></div>
      <div><dt>Mobile</dt><dd><%= phone || 'Not added yet' %></dd></div>
      <div><dt>Employer</dt><dd><%= employer || (registrant.employment_status === 'not_currently_employed' ? 'Not currently employed' : 'Not added yet') %></dd></div>
      <div><dt>Member since</dt><dd><%= fmt(registrant.created_at) %></dd></div>
    </dl>
    <p class="dlinks"><a href="/portal/account">Account settings</a><% if (paid) { %><a href="/portal/billing">Billing</a><% } %><a href="/support">Contact</a></p>
  </aside>

  <div class="dmain">
    <section class="dpanel">
      <h2>Certification status</h2>
      <p class="dstatus"><span class="dpill <%= statusTone %>"><%= statusLabel %></span><% if (reg.registration_number && certified) { %><span class="dnum">No. <%= reg.registration_number %></span><% } %></p>
      <% if (card) { %>
        <p class="dnext-title"><%= card.title %></p>
        <% if (card.html) { %><p class="dtext"><%- card.html %></p><% } else if (card.text) { %><p class="dtext"><%= card.text %></p><% } %>
        <% if (card.href) { %><p class="dactions"><a class="button gold" href="<%= card.href %>"><%= card.cta %></a><% if (card.second) { %> <a class="button secondary" href="<%= card.second.href %>"><%= card.second.label %></a><% } %></p><% } %>
      <% } else if (next) { %>
        <p class="dnext-title">Next step: <%= next.label %></p>
        <% if (next.desc) { %><p class="dtext"><%= next.desc %></p><% } %>
        <p class="dactions"><a class="button gold" href="<%= next.href %>" aria-label="Continue: <%= next.label %>"><%= next.cta || 'Start' %></a></p>
      <% } %>
      <% if (!certified) { %>
      <div class="dprogress" role="img" aria-label="<%= doneCount %> of <%= steps.length %> steps complete"><span style="width: <%= Math.round(doneCount / steps.length * 100) %>%"></span></div>
      <p class="dsmall"><%= doneCount %> of <%= steps.length %> steps complete</p>
      <% } %>
    </section>

    <section class="dpanel">
      <h2>Training</h2>
      <table class="dtable">
        <thead><tr><th>Module</th><th>Status</th></tr></thead>
        <tbody>
        <% train.modules.forEach((m, i) => { %>
          <tr><td><% if (m.unlocked) { %><a href="/portal/training/<%= m.stable_key %>"><%= i + 1 %>. <%= m.title %></a><% } else { %><%= i + 1 %>. <%= m.title %><% } %></td>
            <td><%= m.completed ? 'Complete' : nextMod === m ? (m.started ? 'In progress' : 'Next') : m.unlocked ? 'Not started' : 'Locked' %></td></tr>
        <% }) %>
          <tr><td><% if (train.allComplete) { %><a href="/portal/assessment">Assessment</a><% } else { %>Assessment<% } %></td>
            <td><%= train.assessment && train.assessment.passed ? 'Passed' : train.allComplete ? 'Ready' : 'After training' %></td></tr>
        </tbody>
      </table>
      <% if (!train.modules.length) { %><p class="dsmall">Training opens soon.</p><% } %>
    </section>

    <% if (!certified) { %>
    <section class="dpanel">
      <h2>Application</h2>
      <table class="dtable">
        <thead><tr><th>Step</th><th>Status</th></tr></thead>
        <tbody>
        <% appSteps.forEach(s => { %>
          <tr class="<%= !s.done && !s.href ? 'is-locked' : '' %>"><td><% if (s.href) { %><a href="<%= s.href %>"><%= s.label %></a><% } else { %><%= s.label %><% } %></td><td><%= stepState(s) %></td></tr>
        <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
