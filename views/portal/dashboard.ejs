<%- include('../partials/head') %>
<h1>My Certification</h1>
<%
  const reg = progress.registration || {};
  const fmt = d => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '—';
  const certified = ['active', 'inactive', 'expired', 'suspended', 'revoked'].includes(reg.status);
  const paid = Boolean(reg.paid_at) || certified || ['pending_screening', 'under_review', 'not_approved'].includes(reg.status);
  const passed = Boolean(train.assessment && train.assessment.passed);
%>
<% if (reg.is_demo) { %><p class="demo-banner">DEMO / NOT SCREENED: background screening is not active yet, so this preview credential is not a valid CSBFP certification.</p><% } %>
<dl class="summary">
  <div><dt>Status</dt><dd><%- statusPill(reg.status, false, reg.is_demo) %></dd></div>
  <div><dt>Certification number</dt><dd><%= reg.registration_number || '—' %></dd></div>
  <% if (reg.first_activated_at) { %><div><dt>Certified since</dt><dd><%= fmt(reg.first_activated_at) %></dd></div><% } %>
  <% if (reg.expires_at && certified) { %><div><dt>Valid through</dt><dd><%= fmt(reg.expires_at) %></dd></div><% } %>
</dl>

<% const renewSoon = reg.status === 'active' && reg.expires_at && Date.parse(reg.expires_at) - Date.now() < 30 * 864e5;
   const confirmedRecently = registrant.info_confirmed_at && Date.now() - Date.parse(registrant.info_confirmed_at) < 300 * 864e5; %>
<% if (renewSoon && !confirmedRecently) { %>
<div class="message review-box">
  <p><strong>Annual review:</strong> your certification renews soon. Please check that your <a href="/portal/personal">contact details</a>, <a href="/portal/employment">employment</a> and <a href="/portal/products">products</a> are current.</p>
  <form method="post" action="/portal/confirm-info"><button class="button small" type="submit">My Information Is Current</button></form>
</div>
<% } %>
<% if (flagged) { %>
<p class="alert">We need to confirm a few details before your application can be completed. Please contact <a href="mailto:<%= program.supportEmail %>"><%= program.supportEmail %></a>.</p>
<% } %>

<div class="list-card">
<h2 class="list-card-head">Steps to complete</h2>
<%
  const checkOpen = reg.status === 'pending_screening';
  const screeningState = !screeningEnabled ? 'Not active yet'
    : !paid ? '' : checkOpen && screening && !screening.link_opened_at ? 'Start'
    : checkOpen ? 'Results pending' : screening ? screeningLabel(screening.status) : '';
  const steps = [
    { done: progress.personal, label: 'Personal information', href: '/portal/personal' },
    { done: progress.employment, label: 'Employment', href: '/portal/employment' },
    { done: progress.products, label: 'Financing products', href: '/portal/products' },
    { done: progress.acknowledgments, label: 'Professional standards', href: '/portal/acknowledgments' },
    { done: train.allComplete, label: `Training (${train.modules.filter(m => m.completed).length} of ${train.modules.length} modules)`, href: '/portal/training',
      state: train.allComplete ? 'Complete' : train.modules.some(m => m.started) ? 'In progress' : 'Start' },
    { done: passed, label: 'Assessment', href: train.allComplete ? '/portal/assessment' : null, divider: true,
      locked: !train.allComplete, state: passed ? 'Passed' : !train.allComplete ? '' : 'Start' },
    { done: paid, label: `Annual certification fee (${program.annualFee})`,
      href: passed ? '/portal/checkout' : null, divider: true, locked: !passed && !paid,
      state: reg.status === 'inactive' ? 'Payment due' : reg.status === 'expired' ? 'Renew' : !passed ? '' : 'Start' },
    { done: screeningEnabled && screening && screening.status === 'approved', label: 'Background check', href: checkOpen ? '/portal/background-check' : null, divider: true,
      locked: !paid || !screeningEnabled, state: screeningState },
    { done: certified, label: 'Certification issued', href: certified ? '/portal/confirmation' : null,
      locked: !certified, state: reg.status === 'under_review' ? 'Under review' : reg.status === 'not_approved' ? 'Not approved' : '' },
  ];
  const next = steps.find(s => !s.done && s.href);
%>
<ol class="checklist">
  <% steps.forEach(s => { %>
  <li class="<%= [s.done ? 'done' : '', s.locked ? 'locked' : '', s.divider ? 'divider' : ''].filter(Boolean).join(' ') %>">
    <span class="mark" aria-hidden="true"><% if (s.done) { %><%- include('../partials/check') %><% } %></span>
    <% if (s.href) { %><a href="<%= s.href %>"><%= s.label %></a><% } else { %><span><%= s.label %></span><% } %>
    <% if (!s.done) { %><span class="state"><%= s.state != null ? s.state : 'Start' %></span><% } else { %><span class="visually-hidden"><%= s.state || 'Complete' %></span><% } %>
  </li>
  <% }) %>
</ol>
</div>
<% if (!screeningEnabled && !certified) { %>
<p class="notice-strong">Background screening is not active yet. While the program is in preview, completing these steps produces a demo record only. It is not a valid certification and is never shown publicly as one.</p>
<% } %>

<% if (reg.status === 'inactive') { %>
<p class="alert">Your renewal payment didn't go through, so your certification is Inactive. <a href="/portal/billing">Pay now to reactivate it.</a></p>
<% } else if (reg.status === 'expired') { %>
<p class="message">Your certification has expired. <a href="/portal/checkout">Renew it</a> to make it active again with the same number.</p>
<% } else if (reg.status === 'pending_screening') { %>
<% if (screening && screening.link_opened_at) { %>
<p class="message">Your background check is in progress with Checkr. Results usually take 1–3 days, and we'll email you once they're reviewed.</p>
<% } else { %>
<div class="actions"><a class="button" href="/portal/background-check">Start Your Background Check</a></div>
<% } %>
<% } else if (reg.status === 'under_review') { %>
<p class="message">Your application is under review. We will email you when a decision is made.</p>
<% } else if (reg.status === 'not_approved') { %>
<p class="message">Your application was not approved. To ask about reconsideration, contact <a href="mailto:<%= program.supportEmail %>"><%= program.supportEmail %></a>.</p>
<% } else if (reg.status === 'suspended') { %>
<p class="alert">Your certification is suspended pending review. To respond or ask about the process, contact <a href="mailto:<%= program.supportEmail %>"><%= program.supportEmail %></a>.</p>
<% } else if (reg.status === 'revoked') { %>
<p class="alert">Your certification has been revoked. To ask about the appeal process, contact <a href="mailto:<%= program.supportEmail %>"><%= program.supportEmail %></a>.</p>
<% } else if (reg.status === 'active') { %>
<div class="actions"><a class="button" href="/portal/confirmation">View Certificate</a><a class="button secondary" href="/portal/billing">Billing</a></div>
<% } else if (next) { %>
<div class="actions"><a class="button" href="<%= next.href %>">Continue: <%= next.label.replace(/ \(.*\)$/, '') %></a></div>
<% } %>
<p class="muted portal-links"><a href="/portal/account">Account settings</a><% if (paid) { %> · <a href="/portal/billing">Billing</a><% } %> · <a href="/support">Support and appeals</a></p>
<%- include('../partials/foot') %>
