<%- include('../partials/head') %>
<div class="narrow">
<h1>Create an Account</h1>
<p class="lead">Start your registration. It takes about 30 minutes, and you can save your progress and come back.</p>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="/portal/signup" novalidate>
  <div class="field">
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" autocomplete="email" inputmode="email" value="<%= values.email || '' %>" required <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
    <%- include('../partials/err', { field: 'email' }) %>
  </div>
  <div class="field">
    <label for="phone">Mobile phone number</label>
    <input id="phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="(555) 555-5555" value="<%= values.phone || '' %>" required <% if (errors.phone) { %>aria-invalid="true" aria-describedby="phone-error"<% } %>>
    <%- include('../partials/err', { field: 'phone' }) %>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="website">Leave this field empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>
  <div class="field check">
    <input id="agree" name="agree" type="checkbox" value="yes" <%= values.agree === 'yes' ? 'checked' : '' %>>
    <label for="agree">I agree to the <a href="/legal/terms" target="_blank" rel="noopener">Program Terms</a> and <a href="/legal/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</label>
  </div>
  <%- include('../partials/err', { field: 'agree' }) %>
  <% if (turnstileKey) { %>
  <div class="cf-turnstile" data-sitekey="<%= turnstileKey %>"></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
  <button class="button" type="submit">Create Account</button>
</form>
<p class="muted">We'll email you a 6-digit code to confirm your address. Already have an account? <a href="/portal">Sign in</a>.</p>
</div>
<%- include('../partials/foot') %>
