<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Training</h1>
<% if (!state.curriculum) { %>
<p class="message">Training is not available yet. Please check back soon.</p>
<% } else { %>
<% if (overviewHtml) { %><div class="prose"><%- overviewHtml %></div><% } %>
<div class="list-card">
<h2 class="list-card-head">Modules</h2>
<ol class="checklist modules">
  <% state.modules.forEach((m, i) => { %>
  <li class="<%= m.completed ? 'done' : !m.unlocked ? 'locked' : '' %>">
    <span class="mark" aria-hidden="true"><% if (m.completed) { %><%- include('../partials/check') %><% } %></span>
    <span class="step"><% if (m.unlocked) { %><a href="/portal/training/<%= m.stable_key %>"><%= i + 1 %>. <%= m.title %></a><% } else { %><span><%= i + 1 %>. <%= m.title %></span><% } %>
      <% if (m.summary) { %><span class="step-desc"><%= m.summary %></span><% } %></span>
    <% if (!m.completed) { %><span class="state"><%= !m.unlocked ? '' : m.started ? 'In progress' : 'Start' %></span><% } %>
  </li>
  <% }) %>
  <li class="<%= state.assessment.passed ? 'done' : !state.allComplete ? 'locked' : '' %>">
    <span class="mark" aria-hidden="true"><% if (state.assessment.passed) { %><%- include('../partials/check') %><% } %></span>
    <span class="step"><% if (state.allComplete) { %><a href="/portal/assessment">Assessment</a><% } else { %><span>Assessment</span><% } %>
      <span class="step-desc"><%= state.settings.question_count %> multiple-choice questions; <%= state.settings.pass_percent %>% to pass</span></span>
    <% if (!state.assessment.passed) { %><span class="state"><%= !state.allComplete ? '' : 'Start' %></span><% } %>
  </li>
</ol>
</div>
<% const nextMod = state.modules.find(m => m.unlocked && !m.completed); %>
<div class="actions">
  <% if (nextMod) { %><a class="button" href="/portal/training/<%= nextMod.stable_key %>"><%= nextMod.started ? 'Continue' : 'Start' %>: <%= nextMod.title %></a>
  <% } else if (!state.assessment.passed) { %><a class="button" href="/portal/assessment">Go to the Assessment</a><% } %>
</div>
<p class="muted">Your progress is saved automatically. You can return to any completed module at any time.</p>
<% } %>
<%- include('../partials/foot') %>
