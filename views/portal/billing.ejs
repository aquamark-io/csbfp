<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Billing</h1>
<% if (msg) { %><p class="notice-ok" role="status"><%= msg %></p><% } %>
<% const d = x => x ? new Date(x).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '—'; %>
<% if (registration.status === 'inactive') { %>
  <p class="alert">Your renewal payment didn't go through, so your registration is <strong>Inactive</strong>. Pay now to reactivate it.</p>
  <div class="actions">
    <a class="button" href="/portal/billing/pay">Pay <%= fee %> Now</a>
    <% if (registration.stripe_customer_id) { %><form method="post" action="/portal/billing/manage" class="inline-form"><button class="button secondary" type="submit">Update Payment Method</button></form><% } %>
  </div>
<% } %>
<dl class="summary">
  <div><dt>Annual registration fee</dt><dd><%= fee %> per year</dd></div>
  <div><dt>Status</dt><dd><%- statusPill(registration.status) %></dd></div>
  <% if (registration.expires_at) { %><div><dt>Valid through</dt><dd><%= d(registration.expires_at) %></dd></div><% } %>
  <% if (live) { %>
  <div><dt>Automatic renewal</dt><dd><%= live.cancel_at_period_end ? 'Off' : 'On' %></dd></div>
  <div><dt><%= live.cancel_at_period_end ? 'Registration ends' : 'Next renewal' %></dt><dd><%= d(live.current_period_end) %><%= live.cancel_at_period_end ? '' : ` (${fee})` %></dd></div>
  <% } %>
</dl>

<% if (live && registration.status !== 'inactive') { %>
<div class="actions">
  <form method="post" action="/portal/billing/manage" class="inline-form"><button class="button secondary" type="submit">Update Payment Method &amp; Receipts</button></form>
  <% if (live.cancel_at_period_end) { %>
  <form method="post" action="/portal/billing/resume" class="inline-form"><button class="button" type="submit">Turn Automatic Renewal Back On</button></form>
  <% } else { %>
  <a class="button secondary" href="/portal/billing/cancel">Cancel Automatic Renewal</a>
  <% } %>
</div>
<% } else if (!live && registration.status !== 'active' && registration.status !== 'inactive') { %>
<div class="actions"><a class="button" href="/portal/checkout"><%= registration.first_activated_at ? 'Renew Your Registration' : 'Pay the Registration Fee' %></a></div>
<% } %>

<h2>Payment history</h2>
<% if (!payments.length) { %><p class="muted">No payments yet.</p><% } else { %>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% payments.forEach(p => { %>
    <tr>
      <td><%= d(p.paid_at || p.created_at) %></td>
      <td><%= { initial: 'Registration fee', renewal: 'Annual renewal', reactivation: 'Registration fee (rejoined)' }[p.billing_reason] %><% if (p.period_end) { %>, through <%= d(p.period_end) %><% } %></td>
      <td>$<%= (p.amount_cents / 100).toFixed(2) %></td>
      <td><%= { paid: 'Paid', failed: 'Failed', open: 'Due', refunded: 'Refunded', partially_refunded: 'Partly refunded' }[p.status] %></td>
      <td><% if (p.hosted_invoice_url) { %><a href="<%= p.hosted_invoice_url %>" target="_blank" rel="noopener"><%= p.status === 'paid' ? 'Receipt' : 'View' %></a><% } %></td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<% } %>
<p class="muted">Payments are processed by Stripe. Broker Registry never sees or stores your card details. The registration fee is not refundable.</p>
<%- include('../partials/foot') %>
