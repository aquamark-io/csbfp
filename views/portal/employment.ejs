<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Employment</h1>
<% if (saved) { %><p class="notice-ok" role="status">Saved.</p><% } %>
<% const fmtMonth = d => d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : ''; %>
<% const arrangement = { remote: 'Remote', hybrid: 'Hybrid', on_site: 'On-site' };
   const relType = { employee: 'Employee', contractor_1099: 'Independent contractor', self_employed: 'Self-employed' }; %>

<div class="employment">
  <form method="post" action="/portal/employment/status" class="status-form">
    <fieldset class="field">
      <legend>Are you currently working in the industry?</legend>
      <div class="check"><input id="es-working" type="radio" name="employment_status" value="working" <%= registrant.employment_status === 'working' ? 'checked' : '' %>><label for="es-working">Yes</label></div>
      <div class="check"><input id="es-none" type="radio" name="employment_status" value="not_currently_employed" <%= registrant.employment_status === 'not_currently_employed' ? 'checked' : '' %>><label for="es-none">No</label></div>
    </fieldset>
    <div class="if-no"><button class="button" type="submit">Save</button></div>
  </form>

  <div class="if-yes">
    <% if (!rels.length) { %><p class="muted">Add your current employer to complete this section.</p><% } %>
    <% if (rels.length) { %>
    <ul class="cards">
      <% rels.forEach(r => { %>
      <li class="card-row">
        <div>
          <strong><%= r.company_name %></strong><br>
          <span class="muted-inline"><%= [r.title, relType[r.relationship_type], arrangement[r.work_arrangement], r.start_month ? `Since ${fmtMonth(r.start_month)}` : ''].filter(Boolean).join(' · ') %></span>
        </div>
        <a class="button secondary small" href="/portal/employment/<%= r.id %>">Edit</a>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <div class="actions"><a class="button<%= rels.length ? ' secondary' : '' %>" href="/portal/employment/new">Add Employer</a></div>
  </div>
</div>
<%- include('../partials/foot') %>
