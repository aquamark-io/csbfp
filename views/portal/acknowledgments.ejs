<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Professional Standards</h1>
<% if (!doc) { %>
<p class="message">The professional standards are not available yet. Please check back soon.</p>
<% } else if (current) { %>
<section class="ack-card">
  <div class="ack-body">
    <p class="ack-intro">You accepted these standards on <%= new Date(accepted.accepted_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>.</p>
    <ul class="ack-list done"><% statements.forEach(s => { %><li><span class="ack-box" aria-hidden="true"><%- include('../partials/check') %></span><span><%= s %></span></li><% }) %></ul>
  </div>
</section>
<div class="actions"><a class="button secondary" href="/portal/dashboard">Back to Dashboard</a></div>
<% } else { %>
<p class="lead">Read each statement and check the box to confirm.</p>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="/portal/acknowledgments" novalidate>
  <section class="ack-card">
    <fieldset class="ack-body">
      <legend class="visually-hidden">Professional Standards</legend>
      <ul class="ack-list">
        <% statements.forEach((s, i) => { %>
        <li><input id="ack-<%= i %>" type="checkbox" name="ack_<%= i %>" value="yes" <%= checked[i] ? 'checked' : '' %>><label for="ack-<%= i %>"><%= s %></label></li>
        <% }) %>
      </ul>
    </fieldset>
  </section>
  <div class="actions"><button class="button gold" type="submit">Confirm and Continue</button></div>
</form>
<% } %>
<%- include('../partials/foot') %>
