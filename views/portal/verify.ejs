<%- include('../partials/head') %>
<div class="narrow">
<h1>Enter Your Code</h1>
<% if (email) { %><p class="lead">If <strong><%= email %></strong> can be used to sign in, we've sent a 6-digit code to it. The code expires in 10 minutes.</p><% } %>
<% if (typeof resent !== 'undefined' && resent) { %><p class="notice-ok" role="status">A new code is on its way.</p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="/portal/verify" novalidate>
  <div class="field">
    <label for="code">6-digit code</label>
    <input id="code" class="code-input" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="7" required autofocus>
  </div>
  <button class="button" type="submit">Continue</button>
</form>
<form method="post" action="/portal/resend" class="inline-form">
  <p class="muted">Didn't get it? Check your spam folder, or <button class="link-button" type="submit">send a new code</button>.</p>
</form>
<p class="muted"><a href="/portal">Use a different email</a></p>
</div>
<%- include('../partials/foot') %>
