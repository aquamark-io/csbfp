<%- include('../partials/head') %>
<div class="narrow">
<h1>Sign In</h1>
<p class="lead">Enter your email and we'll send you a 6-digit sign-in code.</p>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<form method="post" action="/portal" novalidate>
  <div class="field">
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" autocomplete="email" inputmode="email" value="<%= email %>" required>
  </div>
  <button class="button" type="submit">Send Code</button>
</form>
<p class="muted">Don't have an account? <a href="/portal/signup">Create an account</a>.</p>
</div>
<%- include('../partials/foot') %>
