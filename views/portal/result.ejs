<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Assessment Result</h1>
<% if (attempt.passed) { %>
  <p class="notice-ok"><strong>Passed.</strong> You answered <%= attempt.correct_count %> of <%= attempt.question_count %> correctly.</p>
  <% if (missed.length) { %>
  <h2 class="missed-title">Questions you missed</h2>
  <ul class="missed-list"><% missed.forEach(m => { %><li><%= m %></li><% }) %></ul>
  <% } %>
  <div class="next-step">
    <p class="next-step-label">Next step</p>
    <p>Pay the annual fee to receive your certification number.</p>
    <div class="actions"><a class="button" href="/portal/dashboard">Go to Your Dashboard</a></div>
  </div>
<% } else { %>
  <p class="alert"><strong>Not passed.</strong> You answered <%= attempt.correct_count %> of <%= attempt.question_count %> correctly. A score of <%= attempt.pass_percent_applied %>% is needed to pass.</p>
  <% if (missed.length) { %>
  <h2 class="missed-title">Questions you missed</h2>
  <ul class="missed-list"><% missed.forEach(m => { %><li><%= m %></li><% }) %></ul>
  <% } %>
  <% if (blocked) { %><p><%= blocked %></p><% } %>
  <% if (state.assessment.attemptsLeft) { %><p class="muted">You have <%= state.assessment.attemptsLeft %> <%= state.assessment.attemptsLeft === 1 ? 'attempt' : 'attempts' %> left.</p><% } %>
  <div class="actions"><a class="button" href="/portal/dashboard">Review the Training</a><a class="button secondary" href="/portal/assessment">Assessment</a></div>
<% } %>
<%- include('../partials/foot') %>
