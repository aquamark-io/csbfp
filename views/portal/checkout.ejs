<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Annual Certification Fee</h1>
<% if (canceled) { %><p class="message">Payment was not completed. You can try again below.</p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
<% if (pay.action === 'pay_invoice') { %>
  <p class="message">Your renewal payment didn't go through. <a href="/portal/billing">Go to Billing</a> to pay and reactivate your certification.</p>
<% } else if (pay.action === 'add_card' && ready) { %>
  <% const paidThrough = new Date(pay.registration.expires_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }); %>
  <p class="lead">Your employer paid for your certification through <strong><%= paidThrough %></strong>. To keep it active after that, put a card on file.</p>
  <dl class="summary">
    <div><dt>First charge</dt><dd><%= fee %> on <%= paidThrough %></dd></div>
    <div><dt>Then</dt><dd><%= fee %> every 12 months until you cancel</dd></div>
  </dl>
  <form method="post" action="/portal/checkout" novalidate>
    <div class="field check">
      <input id="agree_renewal" type="checkbox" name="agree_renewal" value="yes">
      <label for="agree_renewal">I authorize CSBFP to charge <%= fee %> on <%= paidThrough %> and automatically every year after that until I cancel. I can cancel online before any renewal. Fees are non-refundable except where required by law. I will receive an email reminder 30 days before each renewal.</label>
    </div>
    <button class="button" type="submit">Add a Card Securely</button>
  </form>
  <p class="muted">Payment is processed by Stripe and appears on your statement as <%= program.statementDescriptor %>. CSBFP never sees or stores your card details.</p>
<% } else if (pay.registration.status === 'active') { %>
  <p class="notice-ok">Your certification is active. <a href="/portal/billing">View billing</a>.</p>
<% } else if (pay.action !== 'checkout') { %>
  <p class="lead">Payment becomes available once these steps are complete:</p>
  <ul class="plain-list"><% pay.reasons.forEach(r => { %><li><%= r %></li><% }) %></ul>
  <div class="actions"><a class="button secondary" href="/portal/dashboard">Back to Dashboard</a></div>
<% } else if (!ready) { %>
  <p class="message">Payments are not available right now. Please check back soon.</p>
<% } else { %>
  <p class="lead"><%= fee %> per year. Choose how you'd like to pay.</p>
  <div class="pay-cards">
    <section class="home-card">
      <h2 class="home-card-band">I'm paying</h2>
      <form method="post" action="/portal/checkout" class="home-card-body" novalidate>
        <p>Pay by card. Renews automatically each year; cancel anytime from your account.</p>
        <div class="field check pay-consent">
          <input id="agree_renewal" type="checkbox" name="agree_renewal" value="yes">
          <label for="agree_renewal">I authorize CSBFP to charge <%= fee %> today and <%= fee %> each year on my renewal date until I cancel. I can cancel anytime online. Fees are non-refundable except where required by law. See the <a href="/legal/terms#6-certification-term-and-automatic-renewal" target="_blank" rel="noopener">Program Terms</a>.</label>
        </div>
        <div class="pay-actions"><button class="button gold" type="submit">Pay <%= fee %></button></div>
      </form>
    </section>
    <section class="home-card" id="employer">
      <h2 class="home-card-band">My employer is paying</h2>
      <form method="post" action="/portal/checkout#employer" class="home-card-body" novalidate>
        <input type="hidden" name="method" value="employer">
        <p>Enter the Employer ID from your employer. A credit covers one year and doesn't renew automatically.</p>
        <div class="field">
          <label for="employer_number">Employer ID</label>
          <input id="employer_number" name="employer_number" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ER-XXXXXX" maxlength="20" value="<%= employerNumber %>">
        </div>
        <div class="field check pay-consent">
          <input id="agree_terms" type="checkbox" name="agree_terms" value="yes">
          <label for="agree_terms">I agree to the <a href="/legal/terms" target="_blank" rel="noopener">Program Terms</a>.</label>
        </div>
        <div class="pay-actions"><button class="button" type="submit">Use Employer Credit</button></div>
      </form>
    </section>
  </div>
  <p class="muted pay-foot">Card payments are processed securely by Stripe and appear on your statement as <%= program.statementDescriptor %>.</p>
<% } %>
<%- include('../partials/foot') %>
