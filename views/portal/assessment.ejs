<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Assessment</h1>
<% const a = state.assessment; %>
<% if (a && a.passed) { %>
  <p class="notice-ok">You passed the assessment with <%= a.passedAttempt.correct_count %> of <%= a.passedAttempt.question_count %> correct.</p>
  <div class="actions"><a class="button" href="/portal/assessment/result/<%= a.passedAttempt.id %>">See Your Results</a><a class="button secondary" href="/portal/dashboard">Dashboard</a></div>
<% } else if (blocked) { %>
  <p class="message"><%= blocked %></p>
  <% if (a && a.lastAttempt) { %><p class="muted">Your last attempt: <%= a.lastAttempt.correct_count %> of <%= a.lastAttempt.question_count %> correct.</p><% } %>
  <div class="actions"><a class="button secondary" href="/portal/training">Review the Training</a></div>
<% } else { %>
  <% const passCount = Math.ceil(state.settings.question_count * state.settings.pass_percent / 100); %>
  <p class="lead">You're ready for the final step of your training.</p>
  <dl class="summary">
    <div><dt>Questions</dt><dd><%= state.settings.question_count %> multiple choice</dd></div>
    <div><dt>To pass</dt><dd><%= passCount %> correct (<%= state.settings.pass_percent %>%)</dd></div>
    <% if (a.attemptsLeft != null) { %><div><dt>Attempts left</dt><dd><%= a.attemptsLeft %></dd></div><% } %>
    <div><dt>Format</dt><dd>One question per screen, submitted at the end</dd></div>
  </dl>
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form method="post" action="/portal/assessment/start" novalidate>
    <div class="actions"><button class="button gold" type="submit">Begin the Assessment</button></div>
  </form>
<% } %>
<%- include('../partials/foot') %>
