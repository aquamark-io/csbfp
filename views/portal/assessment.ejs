<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<h1>Assessment</h1>
<% const a = state.assessment; %>
<% if (a && a.passed) { %>
  <p class="notice-ok">You passed the assessment with <%= a.passedAttempt.correct_count %> of <%= a.passedAttempt.question_count %> correct.</p>
  <div class="actions"><a class="button" href="/portal/assessment/result/<%= a.passedAttempt.id %>">See Your Results</a></div>
<% } else if (blocked) { %>
  <p class="message"><%= blocked %></p>
  <% if (a && a.lastAttempt) { %><p class="muted">Your last attempt: <%= a.lastAttempt.correct_count %> of <%= a.lastAttempt.question_count %> correct.</p><% } %>
  <div class="actions"><a class="button secondary" href="/portal/dashboard">Review the Training</a></div>
<% } else { %>
  <% const passCount = Math.ceil(state.settings.question_count * state.settings.pass_percent / 100); %>
  <p class="lead"><%= state.settings.question_count %> multiple-choice questions. Answer <%= passCount %> correctly to pass.</p>
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form method="post" action="/portal/assessment/start" novalidate>
    <div class="actions"><button class="button gold" type="submit">Begin the Assessment</button></div>
  </form>
<% } %>
<%- include('../partials/foot') %>
