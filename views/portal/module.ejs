<%- include('../partials/head') %>
<p class="muted"><a href="/portal/training">← Training</a> · Module <%= idx + 1 %> of <%= state.modules.length %></p>
<h1><%= mod.title %></h1>
<% if (video) { %>
<div class="video"><iframe src="<%= video %>" title="<%= mod.title %> video" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
<% } %>
<div class="deck" data-deck>
  <div class="deck-progress" aria-hidden="true"><div class="deck-bar"><span></span></div><span class="deck-count"></span></div>
  <div class="prose slides" aria-live="polite"><%- html %></div>
  <div class="deck-nav">
    <button class="button secondary" type="button" data-prev>← Back</button>
    <button class="button" type="button" data-next>Next →</button>
    <% if (!mod.completed) { %><button class="button" type="submit" form="complete-module" data-finish hidden>Complete Module</button>
    <% } else if (next) { %><a class="button" href="/portal/training/<%= next.stable_key %>" data-finish hidden>Next Module →</a>
    <% } else { %><a class="button" href="/portal/assessment" data-finish hidden>Go to the Assessment</a><% } %>
  </div>
</div>
<div class="module-footer" data-deck-end>
  <% if (mod.completed) { %>
    <p class="notice-ok">You completed this module.</p>
    <div class="actions">
      <% if (prev) { %><a class="button secondary" href="/portal/training/<%= prev.stable_key %>">← <%= prev.title %></a><% } %>
      <% if (next) { %><a class="button" href="/portal/training/<%= next.stable_key %>"><%= next.title %> →</a><% } else { %><a class="button" href="/portal/assessment">Go to the Assessment</a><% } %>
    </div>
  <% } else { %>
    <form method="post" action="/portal/training/<%= mod.stable_key %>/complete" id="complete-module">
      <div class="actions">
        <% if (prev) { %><a class="button secondary" href="/portal/training/<%= prev.stable_key %>">← <%= prev.title %></a><% } %>
        <button class="button" type="submit">Complete Module</button>
      </div>
    </form>
  <% } %>
</div>
<script src="/js/slides.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
