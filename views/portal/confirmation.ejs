<%- include('../partials/head') %>
<%- include('../partials/portal-nav') %>
<% const d = x => x ? new Date(x).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '—'; %>
<div class="confirmation">
  <% if (registration.is_demo) { %><p class="demo-banner">DEMO / NOT SCREENED: this preview record is not a valid CSBFP certification.</p><% } %>
  <img class="conf-logo" src="/img/csbfp-logo.png?v=<%= assetV %>" alt="Certified SBFP" width="126" height="65">
  <p class="conf-org">Certified Small Business Finance Professional</p>
  <h1>Certificate</h1>
  <dl class="summary">
    <div><dt>Name</dt><dd><%= [r.legal_first_name, r.legal_last_name].filter(Boolean).join(' ') %></dd></div>
    <div><dt>Certification number</dt><dd><%= registration.registration_number %></dd></div>
    <div><dt>Status</dt><dd><%- statusPill(registration.status, false, registration.is_demo) %></dd></div>
    <div><dt>Certified since</dt><dd><%= d(registration.first_activated_at) %></dd></div>
    <div><dt><%= registration.status === 'expired' ? 'Expired on' : 'Valid through' %></dt><dd><%= d(registration.expires_at) %></dd></div>
  </dl>
  <p class="muted">Current status can be confirmed at <a href="/verify?number=<%= registration.registration_number %>"><%= program.domain %>/verify</a> using the certification number. CSBFP is a private industry certification. It is not a government license or regulatory approval, and it does not replace any license or registration required by law.</p>
  <p class="muted">Issued <%= d(new Date()) %>.</p>
</div>
<div class="actions no-print"><button class="button" type="button" data-print>Print or Save as PDF</button></div>
<script src="/js/print.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
