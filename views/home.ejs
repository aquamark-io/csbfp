<%- include('partials/head') %>
<section class="home">
  <img class="home-logo" src="/img/csbfp-logo.png?v=<%= assetV %>" alt="Certified Small Business Finance Professional" width="252" height="131">
  <h1 class="visually-hidden">Certified Small Business Finance Professional</h1>
  <p class="subtitle">A professional certification program for individuals working in the small business finance industry.</p>

  <form class="lookup home-lookup" method="get" action="/verify">
    <label for="number">Verify a certification</label>
    <div class="lookup-row">
      <input id="number" name="number" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false"
             placeholder="<%= program.numberPrefix %>-12345678" maxlength="20" required>
      <button class="button" type="submit">Verify</button>
    </div>
  </form>

  <div class="home-or"><span>or</span></div>
  <a class="button large" href="/portal/signup">Get Certified</a>
</section>
<%- include('partials/foot') %>
